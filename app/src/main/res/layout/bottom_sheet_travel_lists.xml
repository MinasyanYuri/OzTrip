<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:minWidth="120dp"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_sheet_luxury"
    android:padding="20dp">

    <!-- Ручка -->
    <View
        android:layout_width="45dp"
        android:layout_height="4dp"
        android:layout_gravity="center"
        android:background="@drawable/bg_handle_orange"
        android:layout_marginBottom="20dp" />

    <!-- Заголовок с иконкой и кнопкой "Выбрать" -->
    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_list_travel"
            app:tint="#FF9800"
            android:layout_marginEnd="8dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="МОИ ПОЕЗДКИ"
            android:textColor="#FF9800"
            android:textSize="14sp"
            android:textStyle="bold"
            android:letterSpacing="0.15" />

        <TextView
            android:id="@+id/btnSelect"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Выбрать"
            android:textColor="#FF9800"
            android:textSize="14sp"
            android:textStyle="bold"
            android:padding="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <!-- Панель выбора (по умолчанию скрыта) -->
    <LinearLayout
        android:id="@+id/selectionToolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp"
        android:background="@android:color/transparent"
        android:visibility="gone"
        android:paddingVertical="4dp">

        <TextView
            android:id="@+id/tvSelectedCount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="0 выбрано"
            android:textColor="#FF9800"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnCancelSelection"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Отмена"
            android:textColor="#B0B0B0"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:textAllCaps="false"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnDeleteSelected"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Удалить"
            android:textColor="#FF5252"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:textAllCaps="false"
            android:enabled="false" />
    </LinearLayout>

    <!-- Поле поиска -->
    <!-- Поле поиска (стеклянное, без квадрата) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_search_glass"
        android:paddingHorizontal="16dp"
        android:layout_marginBottom="12dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_search_mini"
            app:tint="#80FFFFFF" />

        <EditText
            android:id="@+id/etSearchList"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:hint="Поиск поездки..."
            android:textColor="#FFFFFF"
            android:textColorHint="#66FFFFFF"
            android:background="@null"
            android:textSize="14sp"
            android:inputType="text"
            android:paddingHorizontal="8dp" />
    </LinearLayout>

    <!-- Список поездок -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvSheetTravelLists"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="300dp"
        android:overScrollMode="never"
        android:paddingVertical="4dp" />

</LinearLayout>