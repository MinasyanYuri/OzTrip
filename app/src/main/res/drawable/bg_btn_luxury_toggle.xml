<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="oval">
            <solid android:color="#26000000" /> <padding android:bottom="2dp" android:left="2dp" android:right="2dp" android:top="2dp" />
        </shape>
    </item>

    <item>
        <shape android:shape="oval">
            <gradient
                android:startColor="#FFB74D" android:endColor="#FF9800"   android:angle="270"
                android:type="linear" />

            <stroke
                android:width="1dp"
                android:color="#B3FFFFFF" />

            <size android:width="48dp" android:height="48dp" />
        </shape>
    </item>
</layer-list>