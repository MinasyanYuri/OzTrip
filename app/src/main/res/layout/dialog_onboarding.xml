<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_about"
    android:padding="24dp">

    <!-- Карточка внутри диалога -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="24dp"
        app:cardElevation="16dp"
        app:cardBackgroundColor="#FFFFFF"
        app:strokeColor="#FF9800"
        app:strokeWidth="1dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="20dp">

            <!-- Иконка приложения -->
            <ImageView
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:src="@drawable/app_ic"
                android:contentDescription="@string/app_name"
                android:layout_marginBottom="16dp"/>

            <!-- Заголовок -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Добро пожаловать!"
                android:textColor="#FF9800"
                android:textSize="24sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginBottom="8dp"/>

            <!-- Инструкции -->
            <TextView
                android:id="@+id/tvOnboardingMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="• Нажмите и удерживайте на карте, чтобы сохранить место.\n• Используйте поиск для быстрого перехода.\n• Переключайте поездки в верхнем баре.\n• Вкладка AI — ваш умный гид.\n• Смахните вверх карточку для деталей."
                android:textColor="#333333"
                android:textSize="15sp"
                android:lineSpacingExtra="6dp"
                android:gravity="start"
                android:layout_marginBottom="24dp"
                android:paddingHorizontal="4dp"/>

            <!-- Кнопка -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGotIt"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="wrap_content"
                android:layout_height="56dp"
                android:text="Понятно!"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="16sp"
                app:cornerRadius="28dp"
                app:backgroundTint="#FF9800"
                app:rippleColor="#FFA726"
                android:stateListAnimator="@null"
                android:elevation="4dp"
                android:paddingHorizontal="32dp"/>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</androidx.constraintlayout.widget.ConstraintLayout>