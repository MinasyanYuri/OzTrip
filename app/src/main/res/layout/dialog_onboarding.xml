<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_about"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Добро пожаловать в OzTrip!"
        android:textColor="?android:textColorPrimary"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="• Нажмите на карту, чтобы найти место.\n• Используйте поиск, чтобы быстро перемещаться.\n• Кнопка «Сохранить» добавляет точку в текущую поездку.\n• Вкладка «ИИ» — ваш умный помощник.\n• Смахните вверх карточку, чтобы увидеть детали места."
        android:textColor="?android:textColorSecondary"
        android:textSize="14sp" />

    <Button
        android:id="@+id/btnGotIt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="16dp"
        android:text="Понятно!"
        android:backgroundTint="#FF9800"
        android:textColor="#FFF" />
</LinearLayout>