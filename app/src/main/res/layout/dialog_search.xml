<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/bg_dialog_premium">

    <ImageView
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center"
        android:src="@drawable/ic_search_premium"
        android:background="@drawable/bg_circle_orange"
        android:padding="14dp"
        android:layout_marginBottom="12dp"
        app:tint="?attr/colorSurface" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="@string/text_69"
        android:textColor="#FF9800"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <EditText
        android:id="@+id/etSearchQuery"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:hint="@string/text_71"
        android:textColorHint="#999999"
        android:textColor="?attr/colorSurface"
        android:background="@drawable/bg_edittext_premium"
        android:paddingHorizontal="16dp"
        android:textSize="16sp"
        android:imeOptions="actionSearch"
        android:inputType="text"
        android:layout_marginBottom="20dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelSearch"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:text="@string/text_55"
            android:textColor="#B0B0B0"
            app:backgroundTint="#33FFFFFF"
            app:strokeColor="#66FFFFFF"
            app:strokeWidth="1.5dp"
            app:cornerRadius="28dp"
            android:textAllCaps="false"
            android:layout_marginEnd="8dp"
            android:textSize="15sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStartSearch"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:text="@string/text_70"
            android:textColor="?attr/colorSurface"
            app:backgroundTint="#FF9800"
            app:strokeColor="?attr/colorSurface"
            app:strokeWidth="1.5dp"
            app:cornerRadius="28dp"
            android:textAllCaps="false"
            android:layout_marginStart="8dp"
            android:textSize="15sp" />
    </LinearLayout>
</LinearLayout>