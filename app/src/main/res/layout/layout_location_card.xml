<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@drawable/bg_sheet_premium">

    <!-- Ручка -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center"
        android:background="#80FFFFFF"
        android:layout_marginBottom="20dp" />

    <!-- Заголовок + кнопка редактирования -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <TextView
            android:id="@+id/cardTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/text_79"
            android:textColor="#FF9800"
            android:textSize="24sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-black" />

        <ImageButton
            android:id="@+id/btnEditTitle"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_edit_premium"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="?attr/colorSurface" />
    </LinearLayout>

    <!-- Заметка -->
    <EditText
        android:id="@+id/cardDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/text_84"
        android:textColorHint="#B0B0B0"
        android:textColor="?attr/colorSurface"
        android:background="@drawable/bg_edittext_premium"
        android:padding="16dp"
        android:textSize="14sp"
        android:minLines="2"
        android:maxLines="4"
        android:inputType="textMultiLine"
        android:layout_marginBottom="20dp" />

    <!-- Фото: заголовок -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/text_80"
        android:textColor="#FF9800"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginBottom="12dp" />

    <!-- Горизонтальный блок: кнопка добавления + миниатюры фото -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:layout_marginBottom="20dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Квадратная кнопка добавления фото (120x120) -->
            <FrameLayout
                android:id="@+id/flPhotoButton"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_photo_square"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <ImageView
                    android:id="@+id/btnAddPhoto"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_add_photo_premium"
                    android:background="@drawable/bg_circle_photo_button"
                    android:padding="14dp"
                    app:tint="?attr/colorSurface" />
            </FrameLayout>

            <!-- Контейнер для миниатюр фото (справа от кнопки) -->
            <LinearLayout
                android:id="@+id/photoContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />

        </LinearLayout>
    </HorizontalScrollView>

    <!-- Рейтинг -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/text_81"
        android:textColor="?attr/colorSurface"
        android:textSize="14sp"
        android:layout_marginBottom="8dp" />

    <com.google.android.material.slider.Slider
        android:id="@+id/ratingSlider"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:valueFrom="0"
        android:valueTo="100"
        android:stepSize="1"
        app:thumbColor="#FF9800"
        app:trackColorActive="#FF9800"
        app:trackColorInactive="#33FF9800"
        app:labelBehavior="floating"
        android:layout_marginBottom="20dp" />

    <!-- Дата -->
    <LinearLayout
        android:id="@+id/btnPickDate"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_edittext_premium"
        android:paddingHorizontal="16dp"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_calendar_premium"
            app:tint="#FF9800" />

        <TextView
            android:id="@+id/tvDateDisplay"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:text="@string/text_82"
            android:textColor="#B0B0B0"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Кнопка удаления точки -->
    <!-- Кнопка удаления точки (стеклянная, красная) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnDeleteLocation"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="@string/text_83"
        android:textColor="?attr/colorSurface"
        android:textSize="16sp"
        android:textAllCaps="false"
        app:cornerRadius="28dp"
        android:layout_marginTop="8dp"
        app:backgroundTint="#CCFF5252"
        app:strokeColor="?attr/colorSurface"
        app:strokeWidth="1.5dp"
        android:insetLeft="0dp"
        android:insetTop="0dp"
        android:insetRight="0dp"
        android:insetBottom="0dp"
        android:stateListAnimator="@null" />

</LinearLayout>