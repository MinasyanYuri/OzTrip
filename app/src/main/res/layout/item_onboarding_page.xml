<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="32dp">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="100dp"
        android:layout_height="100dp"
        app:cardCornerRadius="50dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="#FFF3E0"
        app:strokeWidth="0dp"
        android:layout_marginBottom="24dp">

        <ImageView
            android:id="@+id/ivOnboardingIcon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="24dp"
            android:src="@drawable/ic_touch_app"
            android:contentDescription="Жест"
            app:tint="#FF9800"/>
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/tvOnboardingTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Долгое нажатие"
        android:textColor="#212121"
        android:textSize="20sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:id="@+id/tvOnboardingDesc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Нажмите и удерживайте на карте, чтобы сохранить место."
        android:textColor="#757575"
        android:textSize="15sp"
        android:gravity="center"
        android:lineSpacingExtra="6dp"/>
</LinearLayout>